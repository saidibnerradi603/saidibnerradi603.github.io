---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getEnrichedArticles } from '../lib/articles';
import { SITE } from '../config/site';

const articles = await getEnrichedArticles();
const featuredArticle = articles.find((a) => a.entry.data.featured) || articles[0];
const otherArticles = articles.filter((a) => a.slug !== featuredArticle?.slug);

const categories = Array.from(new Set(articles.map((a) => a.entry.data.category)));
const totalDiagrams = articles.reduce((acc, a) => acc + a.diagramCount, 0);
---

<BaseLayout>
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-16 sm:px-6 lg:px-8 lg:pt-16">
    <!-- Compact Editorial Masthead -->
    <div class="flex flex-col justify-between gap-6 border-b border-[var(--border-subtle)] pb-10 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-1 font-mono text-[11px] text-[var(--text-secondary)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-primary)]"></span>
          {SITE.author}
        </div>
        <h1 class="mt-4 font-['Plus_Jakarta_Sans'] text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl lg:text-[2.65rem] lg:leading-[1.12]">
          Articles &amp; <span class="text-[var(--accent-primary)]">Notes</span>.
        </h1>
        <p class="mt-3.5 text-base leading-relaxed text-[var(--text-secondary)]">
          {SITE.tagline}
        </p>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2.5">
        <a
          href="/graph"
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-2.5 text-xs font-semibold text-[var(--text-primary)] transition-colors hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)]"
        >
          <svg
            class="h-4 w-4 text-[var(--accent-primary)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="6" cy="6" r="2.5"></circle>
            <circle cx="18" cy="7" r="2.5"></circle>
            <circle cx="12" cy="18" r="2.5"></circle>
            <line x1="8.2" y1="6.8" x2="15.5" y2="7"></line>
            <line x1="7.3" y1="8.1" x2="10.8" y2="15.7"></line>
            <line x1="16.7" y1="9.1" x2="13.2" y2="15.7"></line>
          </svg>
          Explore Knowledge Graph
        </a>
        <a
          href="/rss.xml"
          title="Subscribe via RSS"
          class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2.5 font-mono text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)]"
        >
          RSS
        </a>
      </div>
    </div>

    <!-- Stats Strip -->
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter articles by category">
        <button
          type="button"
          data-filter-category="all"
          class="filter-pill is-active rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
        >
          All ({articles.length})
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              data-filter-category={cat}
              class="filter-pill rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
            >
              {cat}
            </button>
          ))
        }
      </div>

      <div class="font-mono text-[11px] text-[var(--text-muted)]">
        {articles.length} {articles.length === 1 ? 'Article' : 'Articles'} · {totalDiagrams} Diagrams
      </div>
    </div>

    <!-- Featured Deep-Dive -->
    {
      featuredArticle && (
        <div class="mt-8">
          <ArticleCard article={featuredArticle} featured={true} />
        </div>
      )
    }

    <!-- Chronological Feed -->
    {
      otherArticles.length > 0 && (
        <div class="mt-5 grid grid-cols-1 gap-5">
          {otherArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      )
    }

    <!-- Interactive Graph Callout Banner -->
    <div
      class="mt-12 flex flex-col items-start justify-between gap-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:flex-row sm:items-center sm:p-7 graph-dot-grid"
    >
      <div>
        <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[var(--accent-primary)]">
          Connected Thinking
        </span>
        <h2 class="mt-1 font-['Plus_Jakarta_Sans'] text-lg font-bold text-[var(--text-primary)]">
          Wander through the Knowledge Graph
        </h2>
        <p class="mt-1 max-w-xl text-sm text-[var(--text-secondary)]">
          Explore how articles and topics connect visually — drag nodes, filter by topic, and jump directly into any article.
        </p>
      </div>
      <a
        href="/graph"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-[var(--accent-primary)] px-4 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-[var(--accent-hover)]"
      >
        Launch Graph Explorer →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-pill {
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--text-secondary);
  }
  .filter-pill:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }
  .filter-pill.is-active {
    border-color: var(--accent-primary);
    background: var(--accent-primary);
    color: #ffffff;
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-filter-category]');
  const cards = document.querySelectorAll<HTMLElement>('[data-article-card]');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = pill.dataset.filterCategory || 'all';
      pills.forEach((p) => p.classList.toggle('is-active', p === pill));
      cards.forEach((card) => {
        const match = selected === 'all' || card.dataset.category === selected;
        card.classList.toggle('hidden', !match);
      });
    });
  });
</script>
