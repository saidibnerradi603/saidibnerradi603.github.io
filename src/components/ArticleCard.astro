---
import { formatDate, slugifyTag, type EnrichedArticle } from '../lib/articles';

interface Props {
  article: EnrichedArticle;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const { entry, slug, readingTime, diagramCount } = article;
const { title, description, publishedAt, category, tags } = entry.data;
---

<article
  data-article-card
  data-category={category}
  data-tags={tags.join(',').toLowerCase()}
  class:list={[
    'group relative flex flex-col justify-between rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-7 transition-all duration-200 hover:border-[var(--accent-primary)]/60',
    featured && 'shadow-[var(--shadow-card)]',
  ]}
>
  <div>
    <!-- Meta Top Row -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
      {
        featured && (
          <span class="inline-flex items-center gap-1 rounded-full bg-[var(--accent-gold-soft)] px-2.5 py-0.5 font-mono text-[11px] font-semibold text-[var(--accent-gold)]">
            ★ Featured Guide
          </span>
        )
      }
      <a
        href={`/topics/${slugifyTag(category)}`}
        class="rounded-full bg-[var(--accent-soft)] px-2.5 py-0.5 font-mono text-[11px] font-medium text-[var(--accent-primary)] transition-colors hover:bg-[var(--accent-primary)] hover:text-white"
      >
        {category}
      </a>
      <span class="text-[var(--text-muted)]">•</span>
      <time datetime={publishedAt.toISOString()} class="font-mono text-[11px] text-[var(--text-muted)]">
        {formatDate(publishedAt)}
      </time>
      <span class="text-[var(--text-muted)]">•</span>
      <span class="font-mono text-[11px] text-[var(--text-muted)]">{readingTime}</span>
      {
        diagramCount > 0 && (
          <>
            <span class="text-[var(--text-muted)]">•</span>
            <span class="font-mono text-[11px] text-[var(--text-secondary)]">
              {diagramCount} {diagramCount === 1 ? 'Diagram' : 'Diagrams'}
            </span>
          </>
        )
      }
    </div>

    <!-- Title -->
    <h2
      class="mt-3 font-['Plus_Jakarta_Sans'] text-2xl sm:text-[1.65rem] font-bold leading-tight tracking-tight text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent-primary)]"
    >
      <a href={`/articles/${slug}`} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h2>

    <!-- Description -->
    <p class="mt-2.5 max-w-3xl text-base leading-relaxed text-[var(--text-secondary)]">
      {description}
    </p>
  </div>

  <!-- Tags + Read Link -->
  <div class="relative z-10 mt-5 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-[var(--border-subtle)]/70">
    <div class="flex flex-wrap gap-1.5">
      {
        tags.slice(0, 6).map((tag) => (
          <a
            href={`/topics/${slugifyTag(tag)}`}
            class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)]"
          >
            #{tag}
          </a>
        ))
      }
    </div>

    <span class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--accent-primary)] transition-transform group-hover:translate-x-0.5">
      Read guide
      <svg
        class="h-3.5 w-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </span>
  </div>
</article>
