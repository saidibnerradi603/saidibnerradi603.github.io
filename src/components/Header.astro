---
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Articles', active: pathname === '/' || pathname.startsWith('/articles') },
  { href: '/graph', label: 'Graph', active: pathname.startsWith('/graph'), isGraph: true },
  { href: '/topics', label: 'Topics', active: pathname.startsWith('/topics') },
  { href: '/about', label: 'About', active: pathname.startsWith('/about') },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--border-subtle)] bg-[var(--bg-glass)] backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] font-['Plus_Jakarta_Sans'] text-base font-extrabold tracking-tight text-[var(--text-primary)] transition-colors group-hover:border-[var(--accent-primary)]"
      >
        S<span class="text-[var(--accent-primary)]">.</span>
      </span>
      <span class="font-['Plus_Jakarta_Sans'] text-[0.95rem] font-bold tracking-tight text-[var(--text-primary)]">
        {SITE.name}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
              link.active
                ? 'bg-[var(--accent-soft)] text-[var(--accent-primary)]'
                : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface)] hover:text-[var(--text-primary)]',
            ]}
          >
            {link.isGraph && (
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="6" cy="6" r="2.5" />
                <circle cx="18" cy="7" r="2.5" />
                <circle cx="12" cy="18" r="2.5" />
                <line x1="8.2" y1="6.8" x2="15.5" y2="7" />
                <line x1="7.3" y1="8.1" x2="10.8" y2="15.7" />
                <line x1="16.7" y1="9.1" x2="13.2" y2="15.7" />
              </svg>
            )}
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- Search Trigger -->
      <button
        type="button"
        data-search-open
        aria-label="Search articles"
        class="inline-flex h-9 items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-primary)] hover:text-[var(--text-primary)] cursor-pointer sm:px-3"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd
          class="hidden rounded border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-muted)] sm:inline-block"
        >
          ⌘K
        </kbd>
      </button>

      <ThemeToggle />

      <a
        href={SITE.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden h-9 items-center gap-1 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 text-xs font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] sm:inline-flex"
      >
        Portfolio
        <svg
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 17 17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] md:hidden cursor-pointer"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-4 py-3 md:hidden"
  >
    <nav class="flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              link.active
                ? 'bg-[var(--accent-soft)] text-[var(--accent-primary)]'
                : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface)]',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={SITE.portfolioUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 rounded-lg px-3 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-surface)]"
      >
        Portfolio ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    toggleBtn.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
